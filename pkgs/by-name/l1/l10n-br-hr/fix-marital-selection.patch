+@api.model
+def _get_marital_status_selection(self):
+    try:
+        res = super()._get_marital_status_selection()
+    except AttributeError:
+        # Fallback: get the selection from the field definition
+        field = self.env['hr.employee']._fields.get('marital')
+        if field and hasattr(field, 'selection'):
+            res = field.selection
+            if callable(res):
+                res = res(self.env)
+        else:
+            res = []
+    return res + [
+        ("common_law_marriage", self.env._("Common law marriage")),
+        ("separated", self.env._("Separated")),
+    ]

